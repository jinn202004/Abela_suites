# Express API base URL (no trailing slash). Used for `/api/rooms`, `/api/auth/*`, etc.
# Leave unset to use relative `/api/...` on the same host (Vite dev proxies /api → the dev API).
# If you run ONLY `npm run dev:web` (Vite) and the API separately on port 5000, set this so the browser calls the API directly (CORS is enabled on the API):
# VITE_API_BASE_URL=http://127.0.0.1:5000
#
# When the API uses a non-default PORT, set this so Vite's dev proxy matches (default http://127.0.0.1:5000).
# VITE_DEV_API_PROXY=http://127.0.0.1:5001
#
# Admin menu image upload: set false so failed S3/API calls show errors instead of a local data-URL preview.
# VITE_MENU_IMAGE_LOCAL_FALLBACK=false

# Walk-in POS orders are stored under this guest user (must exist in MongoDB with role `guest`).
# VITE_POS_WALK_IN_GUEST_EMAIL=guest@abela.demo
